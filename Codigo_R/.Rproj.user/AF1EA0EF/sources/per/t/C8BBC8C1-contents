        time: 0,            // tiempo de animacion en beats, dentro de [0, loopP)
        lastFrame: null,
        raf: null,
        scale: 1,
        gBalls: 3,          // grafo: pelotas
        gHorizon: 5,        // grafo: lanzamiento maximo m
        exState: 0,         // explorador: estado actual (bits 1..m)
        exSeq: []
      };

      // ---------- utilidades ----------
      function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
      function groupDigits(s) {
        let out = '';
        let c = 0;
        for (let i = s.length - 1; i >= 0; i -= 1) {
          out = s[i] + out;
          c += 1;
          if (c % 3 === 0 && i > 0) out = ' ' + out;
        }
        return out;
      }
      function charToVal(ch) {
        if (ch >= '0' && ch <= '9') return ch.charCodeAt(0) - 48;
        if (ch >= 'a' && ch <= 'z') return ch.charCodeAt(0) - 87;   // a = 10, b = 11, ...
        return -1;
      }
      function valToChar(v) { return v < 10 ? String(v) : String.fromCharCode(87 + v); }

      // ---------- analisis del siteswap ----------
      function analyze(raw) {
        const text = raw.toLowerCase().replace(/[ ,.]/g, '');
        if (!text.length) return { ok: false, error: 'Escribe una sucesión de lanzamientos: dígitos 0–9 y letras a–z (a = 10, b = 11…).' };
        const values = [];
        for (let i = 0; i < text.length; i += 1) {
          const v = charToVal(text[i]);
          if (v < 0) return { ok: false, error: `No entiendo el símbolo «${text[i]}»: usa dígitos 0–9 o letras a–z (a = 10, b = 11…).` };
          values.push(v);
        }
        const n = values.length;
        const sum = values.reduce(function (a, b) { return a + b; }, 0);
        const avgNum = sum / n;
        const landings = values.map(function (a, i) { return (i + a) % n; });
        const hit = new Array(n).fill(-1);
        const collisions = [];
        landings.forEach(function (L, i) {
          if (hit[L] >= 0) collisions.push([hit[L], i, L]); else hit[L] = i;
        });
        const valid = collisions.length === 0;
        const balls = valid ? sum / n : null;
        // ciclos de la permutacion (orbitas de los beats)
        let cycles = [];
        if (valid) {
          const seen = new Array(n).fill(false);
          for (let i = 0; i < n; i += 1) {
            if (seen[i]) continue;
            const cyc = [];
            let j = i;
            while (!seen[j]) { seen[j] = true; cyc.push(j); j = landings[j]; }
            cycles.push(cyc);
          }
        }
        return {
          ok: true,
          text: text,
          values: values,
          n: n,
          sum: sum,
          avg: avgNum,
          avgInt: Number.isInteger(avgNum),
          landings: landings,
          collisions: collisions,
          valid: valid,
          balls: balls,
          maxThrow: Math.max.apply(null, values),
          cycles: cycles
        };
      }
      function begwCount(n, b) {
        // Buhler–Eisenbud–Graham–Wright (1994): (b+1)^n − b^n sucesiones de periodo n con b pelotas
        const bb = BigInt(b);
        const nn = BigInt(n);
        function pow(base, exp) { let r = 1n; for (let k = 0n; k < exp; k += 1n) r *= base; return r; }
        return pow(bb + 1n, nn) - pow(bb, nn);
      }

      // ---------- simulacion: eventos de lanzamiento con identidad de pelota ----------
      function buildSim(an) {
        if (!an || !an.valid || an.balls === 0) return { events: [], loopP: 2, T0: 0, G: 60, balls: 0, states: [] };
        const n = an.n;
        const values = an.values;
        // periodo del bucle visual: los colores se repiten cuando cada ciclo de la permutacion completa su rotacion.
        // Un ciclo C lleva k_C = (suma de sus lanzamientos)/n pelotas que van turnandose: su periodo es n*k_C beats.
        // El bucle correcto es lcm(2, n*k_C) sobre todos los ciclos (el 2 respeta la alternancia de manos).
        function gcd2(x, y) { while (y) { const z = x % y; x = y; y = z; } return x; }
        let loopP = 2;
        an.cycles.forEach(function (cyc) {
          const s = cyc.reduce(function (acc, i) { return acc + values[i]; }, 0);
          const kC = Math.round(s / n);
          if (kC > 0) { const p = n * kC; loopP = loopP * p / gcd2(loopP, p); }
        });
        if (loopP > 600) loopP = (n % 2 === 0) ? n : 2 * n;   // salvaguarda para patrones patologicos
        const maxA = Math.max(2, an.maxThrow);
        const warm = 40 + maxA * 3;
        const T0 = Math.ceil(warm / loopP) * loopP;
        const span = T0 + loopP + 1;
        const incoming = {};
        let nextId = 0;
        const events = [];
        for (let t = 0; t < span; t += 1) {
          const a = values[t % n];
          let ball = -1;
          if (Object.prototype.hasOwnProperty.call(incoming, t)) { ball = incoming[t]; delete incoming[t]; }
          if (a > 0) {
            if (ball < 0) ball = nextId++;
            incoming[t + a] = ball;
            if (t + a > T0 - maxA - 1 && t < T0 + loopP) {
              events.push({ t: t, a: a, ball: ball, from: t % 2, to: (t + a) % 2 });
            }
          }
        }
        // estado antes de cada beat del periodo: calendario de las pelotas ya lanzadas (en vuelo o aterrizando ahora)
        const states = [];
        for (let k = 0; k < n; k += 1) {
          const t = T0 + k;
          let mask = 0;
          events.forEach(function (e) {
            if (e.t < t && e.t + e.a >= t) {
              const d = e.t + e.a - t + 1;   // bit 1 = aterriza ahora mismo
              if (d <= maxA) mask |= (1 << d);
            }
          });
          states.push(mask);
        }
        // gravedad calibrada: el lanzamiento mas alto llega al 78% del lienzo
        const Tmax = Math.max(0.6, an.maxThrow - DWELL);
        const G = 8 * (H - HAND_Y - 66) / (Tmax * Tmax);
        return { events: events, loopP: loopP, T0: T0, G: G, balls: an.balls, states: states, maxA: maxA };
      }

      function handPos(hand, time) {
        // la mano lanza en los beats t ≡ hand (mod 2): ciclo de 2 beats, dentro→fuera vacía y fuera→dentro cargando
        const side = hand === 0 ? 1 : -1;
        let phi = (time - hand) % 2;
        if (phi < 0) phi += 2;
        const carry = phi > 2 - DWELL;
        const u = carry ? (phi - (2 - DWELL)) / DWELL : phi / (2 - DWELL);
        const x0 = carry ? OUTER_X : INNER_X;
        const x1 = carry ? INNER_X : OUTER_X;
        const x = side * (x0 + (x1 - x0) * u);
        const y = HAND_Y + (carry ? 8 * Math.sin(Math.PI * u) : 3 * Math.sin(Math.PI * u));
        return { x: W / 2 + x, y: y, carry: carry };
      }

      function ballPositions(time) {
        const sim = state.sim;
        const out = [];
        if (!sim || !sim.events.length) return out;
        const abs = sim.T0 + (time % sim.loopP);
        sim.events.forEach(function (e) {
          if (abs < e.t || abs >= e.t + e.a) return;
          const local = abs - e.t;
          if (e.a === 2) {
            const hp = handPos(e.from, abs);
            out.push({ ball: e.ball, x: hp.x, y: hp.y + 4, held: true });
            return;
          }
          const flight = e.a - DWELL;
          const sideFrom = e.from === 0 ? 1 : -1;
          const sideTo = e.to === 0 ? 1 : -1;
          const x1 = W / 2 + sideFrom * INNER_X;
          const x2 = W / 2 + sideTo * OUTER_X;
          if (local < flight) {
            const u = local / flight;
            const hmax = sim.G * flight * flight / 8;
            out.push({ ball: e.ball, x: x1 + (x2 - x1) * u, y: HAND_Y + 6 + hmax * 4 * u * (1 - u), held: false, a: e.a, u: u });
          } else {
            const hp = handPos(e.to, abs);
            out.push({ ball: e.ball, x: hp.x, y: hp.y + 4, held: true });
          }
        });
        return out;
      }

      // ---------- lienzo ----------
      function resizeCanvas() {
        const canvas = els.canvas;
        const rect = canvas.getBoundingClientRect();
        const cssW = rect.width || W;
        const cssH = cssW * H / W;
        canvas.style.height = cssH + 'px';
        const dpr = window.devicePixelRatio || 1;
        const w = Math.max(1, Math.round(cssW * dpr));
        const h = Math.max(1, Math.round(cssH * dpr));
        if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
        state.scale = w / W;
      }
      function sy(y) { return H - y; }

      function drawCanvas() {
        const ctx = els.canvas.getContext('2d');
        if (!ctx) return;
        ctx.setTransform(state.scale, 0, 0, state.scale, 0, 0);
        ctx.clearRect(0, 0, W, H);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, W, H);
        // suelo
        ctx.strokeStyle = 'rgba(15,23,42,0.14)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(24, sy(FLOOR));
        ctx.lineTo(W - 24, sy(FLOOR));
        ctx.stroke();
        const an = state.analysis;
        if (!an || !an.ok || !an.valid) {
          ctx.fillStyle = '#94a3b8';
          ctx.font = '700 15px Inter, ui-sans-serif, system-ui, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(an && an.ok ? 'Este siteswap no es malabareable: mira las colisiones en el diagrama' : 'Escribe un siteswap para animarlo', W / 2, sy(H / 2));
          drawHands(ctx, state.time);
          return;
        }
        if (an.balls === 0) {
          ctx.fillStyle = '#94a3b8';
          ctx.font = '700 15px Inter, ui-sans-serif, system-ui, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('Cero pelotas: el patrón vacío también es válido (y aburrido)', W / 2, sy(H / 2));
          drawHands(ctx, state.time);
          return;
        }
        // etiqueta del lanzamiento del beat actual, junto a la mano que lanza
        const beatAbs = Math.floor(state.time);
        const a = an.values[((beatAbs % an.n) + an.n) % an.n];
        const hand = beatAbs % 2;
        const frac = state.time - beatAbs;
        if (a > 0 && frac < 0.5) {
          const side = hand === 0 ? 1 : -1;
          ctx.fillStyle = 'rgba(124,58,237,' + (0.85 * (1 - frac * 2)).toFixed(2) + ')';
          ctx.font = '900 26px Inter, ui-sans-serif, system-ui, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(valToChar(a), W / 2 + side * INNER_X, sy(HAND_Y + 52));
        }
        drawHands(ctx, state.time);
        const balls = ballPositions(state.time);
        balls.sort(function (p, q) { return q.y - p.y; });
        balls.forEach(function (b) {
          const col = BALL_COLORS[b.ball % BALL_COLORS.length];
          ctx.save();
          ctx.beginPath();
          ctx.arc(b.x, sy(b.y) + 3, BALL_R * 0.92, 0, 2 * Math.PI);
          ctx.fillStyle = 'rgba(15,23,42,0.10)';
          ctx.fill();
          ctx.beginPath();
          ctx.arc(b.x, sy(b.y), BALL_R, 0, 2 * Math.PI);
          ctx.fillStyle = col;
          ctx.fill();
          ctx.beginPath();
          ctx.arc(b.x - 3.5, sy(b.y) - 3.5, BALL_R * 0.34, 0, 2 * Math.PI);
          ctx.fillStyle = 'rgba(255,255,255,0.55)';
          ctx.fill();
          ctx.restore();
        });
        // contador de beat
        ctx.fillStyle = '#64748b';
        ctx.font = '700 11px Inter, ui-sans-serif, system-ui, sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText('beat ' + (beatAbs % an.n) + ' de ' + an.n + ' · mano ' + (hand === 0 ? 'derecha' : 'izquierda') + ' · ' + state.tempo.toFixed(1) + ' beats/s', 24, sy(FLOOR) + 18);
        ctx.textAlign = 'right';
        ctx.fillText('altura ∝ (tiempo de vuelo)²: subir un número cuesta cada vez más', W - 24, sy(FLOOR) + 18);
      }
      function drawHands(ctx, time) {
        [0, 1].forEach(function (h) {
          const hp = handPos(h, time);
          ctx.save();
          ctx.strokeStyle = hp.carry ? '#0f172a' : '#475569';
          ctx.lineWidth = 6;
          ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.arc(hp.x, sy(hp.y) + 6, 17, Math.PI * 0.12, Math.PI * 0.88, false);
          ctx.stroke();
          ctx.restore();
        });
      }

      // ---------- animacion ----------
      function frame(now) {
        state.raf = null;
        if (state.lastFrame === null) state.lastFrame = now;
        const dt = Math.min(0.08, (now - state.lastFrame) / 1000);
        state.lastFrame = now;
        if (state.playing) {
          const P = state.sim ? state.sim.loopP : 2;
          state.time = (state.time + dt * state.tempo) % P;
          drawCanvas();
          updateTicker();
        }
        state.raf = window.requestAnimationFrame(frame);
      }
      function updateTicker() {
        const an = state.analysis;
        if (!an || !an.ok) return;
        const idx = Math.floor(state.time) % an.n;
        const chips = els.ticker.children;
        for (let i = 0; i < chips.length; i += 1) chips[i].classList.toggle('active', i === idx);
      }
      function renderTicker() {
        const an = state.analysis;
        if (!an || !an.ok) { els.ticker.innerHTML = ''; return; }
        let html = '';
        for (let i = 0; i < an.n; i += 1) {
          html += `<span class='beat-chip'>${valToChar(an.values[i])}</span>`;
        }
        els.ticker.innerHTML = html;
      }

      // ---------- diagrama de aterrizajes (la prueba de la permutacion, en circulo) ----------
      function renderPerm() {
        const an = state.analysis;
        const width = 480;
        const height = 340;
        if (!an || !an.ok) {
          els.permBox.innerHTML = `<svg viewBox='0 0 ${width} ${height}'><rect width='100%' height='100%' fill='#ffffff'></rect><text x='${width / 2}' y='${height / 2}' text-anchor='middle' font-size='13' font-weight='700' fill='#94a3b8' font-family='Inter, sans-serif'>El diagrama aparecerá con un siteswap válido de leer</text></svg>`;
          els.permMeta.innerHTML = an ? an.error : '';
          return;
        }
        const n = an.n;
        const cx = width / 2;
        const cy = height / 2 + 4;
        const R = Math.min(width, height) / 2 - 52;
        const pos = [];
        for (let i = 0; i < n; i += 1) {
          const th = -Math.PI / 2 + 2 * Math.PI * i / n;
          pos.push({ x: cx + R * Math.cos(th), y: cy + R * Math.sin(th) });
        }
        const collided = {};
        an.collisions.forEach(function (c) { collided[c[2]] = true; });
        const parts = [];
        parts.push(`<svg viewBox='0 0 ${width} ${height}' aria-label='Prueba de la permutación'>`);
        parts.push(`<rect width='100%' height='100%' fill='#ffffff'></rect>`);
        parts.push(`<defs><marker id='arr' viewBox='0 0 8 8' refX='7' refY='4' markerWidth='7' markerHeight='7' orient='auto-start-reverse'><path d='M0,0 L8,4 L0,8 z' fill='context-stroke'></path></marker></defs>`);
        // cuerdas i -> (i + a_i) mod n
        for (let i = 0; i < n; i += 1) {
          const j = an.landings[i];
          const bad = collided[j];
          const col = bad ? '#e11d48' : (an.values[i] === 0 ? '#cbd5e1' : '#7c3aed');
          if (i === j) {
            const th = -Math.PI / 2 + 2 * Math.PI * i / n;
            const lx = cx + (R + 22) * Math.cos(th);
            const ly = cy + (R + 22) * Math.sin(th);
            parts.push(`<circle cx='${lx.toFixed(1)}' cy='${ly.toFixed(1)}' r='11' fill='none' stroke='${col}' stroke-width='2'></circle>`);
            continue;
          }
          const mx = (pos[i].x + pos[j].x) / 2;
          const my = (pos[i].y + pos[j].y) / 2;
          const qx = mx + (cx - mx) * 0.55;
          const qy = my + (cy - my) * 0.55;
          const dx = pos[j].x - qx;
          const dy = pos[j].y - qy;
          const dd = Math.hypot(dx, dy) || 1;
          const ex = pos[j].x - dx / dd * 13;
          const ey = pos[j].y - dy / dd * 13;
          parts.push(`<path d='M ${pos[i].x.toFixed(1)} ${pos[i].y.toFixed(1)} Q ${qx.toFixed(1)} ${qy.toFixed(1)} ${ex.toFixed(1)} ${ey.toFixed(1)}' fill='none' stroke='${col}' stroke-width='2.2' opacity='0.85' marker-end='url(#arr)'></path>`);
        }
        for (let i = 0; i < n; i += 1) {
          const bad = collided[i];
          parts.push(`<circle cx='${pos[i].x.toFixed(1)}' cy='${pos[i].y.toFixed(1)}' r='13' fill='${bad ? '#e11d48' : '#0f172a'}'></circle>`);
          parts.push(`<text x='${pos[i].x.toFixed(1)}' y='${(pos[i].y + 4).toFixed(1)}' text-anchor='middle' font-size='12' font-weight='800' fill='#ffffff' font-family='Inter, sans-serif'>${i}</text>`);
          const th = -Math.PI / 2 + 2 * Math.PI * i / n;
          parts.push(`<text x='${(cx + (R + 30) * Math.cos(th)).toFixed(1)}' y='${(cy + (R + 30) * Math.sin(th) + 4).toFixed(1)}' text-anchor='middle' font-size='12' font-weight='800' fill='#7c3aed' font-family='Inter, sans-serif'>${valToChar(an.values[i])}</text>`);
        }
        parts.push(`</svg>`);
        els.permBox.innerHTML = parts.join('');

        const sumTxt = an.values.map(valToChar).join(' + ');
        let meta = `Teorema del promedio: (${sumTxt}) / ${n} = <strong>${an.avgInt ? an.avg : an.sum + '/' + n}</strong>`;
        meta += an.avgInt ? ' pelotas: media entera ✓.' : ': la media <strong>no es entera</strong>, así que no existe patrón con esta sucesión ✗.';
        if (an.avgInt && !an.valid) {
          const c = an.collisions[0];
          meta += ` Pero la media entera no basta: los beats <strong>${c[0]}</strong> y <strong>${c[1]}</strong> aterrizan a la vez en el tiempo <strong>${c[2]}</strong> (mod ${n}), y i ↦ i + aᵢ no es permutación ✗.`;
        }
        if (an.valid) {
          meta += ` La aplicación i ↦ i + aᵢ (mod ${n}) es una permutación ✓ con ${an.cycles.length} ciclo${an.cycles.length === 1 ? '' : 's'}: ` + an.cycles.map(function (c) { return '(' + c.join(' ') + ')'; }).join(' ') + '.';
        }
        els.permMeta.innerHTML = meta;
      }

      // ---------- tarjetas de arriba ----------
      function renderStats() {
        const an = state.analysis;
        if (!an || !an.ok) {
          els.statBalls.textContent = '—';
          els.statBallsSub.textContent = 'b = (a₁ + ⋯ + aₙ) / n';
          els.statPeriod.textContent = '—';
          els.statPeriodSub.textContent = 'longitud de la sucesión';
          els.statValid.textContent = '—';
          els.statValidSub.textContent = 'i ↦ i + aᵢ (mod n) debe ser permutación';
          els.statCount.textContent = '—';
          els.statCountSub.textContent = '(b+1)ⁿ − bⁿ · Buhler–Eisenbud–Graham–Wright (1994)';
          return;
        }
        els.statBalls.textContent = an.avgInt ? String(an.avg) : an.sum + '/' + an.n;
        els.statBallsSub.textContent = an.avgInt ? 'teorema del promedio: la media de la sucesión' : 'la media no es entera: no hay patrón posible';
        els.statPeriod.textContent = String(an.n);
        els.statPeriodSub.textContent = 'beats por ciclo · las manos alternan derecha–izquierda';
        els.statValid.textContent = an.valid ? '✓ sí' : '✗ no';
        els.statValidSub.textContent = an.valid ? 'i ↦ i + aᵢ (mod n) es permutación: nunca caen dos a la vez' : (an.avgInt ? 'dos pelotas aterrizan en el mismo beat' : 'media no entera');
        if (an.avgInt && an.balls !== null) {
          els.statCount.textContent = groupDigits(begwCount(an.n, an.balls).toString());
          els.statCountSub.textContent = `(${an.balls}+1)^${an.n} − ${an.balls}^${an.n} sucesiones de período ${an.n} con ${an.balls} pelotas (BEGW 1994)`;
        } else if (an.avgInt) {
          els.statCount.textContent = groupDigits(begwCount(an.n, Math.round(an.avg)).toString());
          els.statCountSub.textContent = `(b+1)ⁿ − bⁿ con b = ${Math.round(an.avg)}, n = ${an.n} (BEGW 1994)`;
        } else {
          els.statCount.textContent = '—';
          els.statCountSub.textContent = '(b+1)ⁿ − bⁿ · Buhler–Eisenbud–Graham–Wright (1994)';
        }
      }

      function statusMessage() {
        const an = state.analysis;
        if (!an || !an.ok) return an ? an.error : '';
        if (!an.avgInt) return `«${an.text}» suma ${an.sum} en ${an.n} beats: media ${an.sum}/${an.n}, no entera. El teorema del promedio dice que el número de pelotas es la media, así que este patrón no existe. Prueba quitando o cambiando un lanzamiento.`;
        if (!an.valid) {
          const c = an.collisions[0];
          return `«${an.text}» tiene media entera (${an.avg} pelotas), pero los lanzamientos de los beats ${c[0]} y ${c[1]} caerían a la vez en el beat ${c[2]}: el recíproco del teorema del promedio es falso, como en 432. Mira las flechas rojas del diagrama.`;
        }
        if (an.balls === 0) return 'El patrón vacío: válido, con cero pelotas. Los teoremas también cuentan los casos triviales.';
        const cross = an.values.filter(function (v) { return v % 2 === 1; }).length;
        return `«${an.text}»: ${an.balls} pelota${an.balls === 1 ? '' : 's'}, período ${an.n}. Los lanzamientos impares cruzan de mano y los pares vuelven a la misma (${cross} de ${an.n} cruzan). Cada pelota sigue los ciclos de la permutación del diagrama; abajo a la derecha, el grafo de estados recorre este patrón como un ciclo.`;
      }

      // ---------- grafo de estados: subconjuntos de b aterrizajes entre {1..m} ----------
      function comb(m, b) { let r = 1; for (let i = 0; i < b; i += 1) r = r * (m - i) / (i + 1); return Math.round(r); }
      function stateList(b, m) {
        const out = [];
        const total = 1 << m;
        for (let mask = 0; mask < total; mask += 1) {
          let c = 0;
          for (let i = 0; i < m; i += 1) if (mask & (1 << i)) c += 1;
          if (c === b) out.push(mask << 1);   // bits 1..m
        }
        return out;
      }
      function bitCount(x) { let c = 0; while (x) { c += x & 1; x >>= 1; } return c; }
      function throwFrom(mask, a, m) {
        // devuelve el estado tras lanzar a (o null si es ilegal)
        if (!(mask & 2)) return a === 0 ? (mask >> 1) : null;          // sin pelota ahora: solo el beat vacío 0
