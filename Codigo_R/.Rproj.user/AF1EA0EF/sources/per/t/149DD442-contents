      }
      function zeroCircleRadius() { return Math.sqrt(Math.max(0, polarConstant() / Math.PI)); }
      function polarJoint(T, prev) {
        const O = state.pole;
        const L1 = poleArm();
        const L = state.L;
        const d = dist(O, T);
        if (d < 1e-6) return prev || null;
        if (d > L1 + L + 1e-9 || d < Math.abs(L1 - L) - 1e-9) return null;
        const a = (L1 * L1 - L * L + d * d) / (2 * d);
        const h = Math.sqrt(Math.max(0, L1 * L1 - a * a));
        const ex = (T.x - O.x) / d;
        const ey = (T.y - O.y) / d;
