        const A1 = { x: M.x - h * ey, y: M.y + h * ex };   // codo a la izquierda del rayo O→T
        const A2 = { x: M.x + h * ey, y: M.y - h * ex };
        if (prev) return dist(A1, prev) <= dist(A2, prev) ? A1 : A2;   // continuidad de la configuración
        return A1.y >= A2.y ? A1 : A2;                                  // al empezar: el codo más alto, hacia la mesa
      }
      function unwrapTo(prev, ang) {
        let dlt = ang - prev;
        while (dlt > Math.PI) dlt -= 2 * Math.PI;
