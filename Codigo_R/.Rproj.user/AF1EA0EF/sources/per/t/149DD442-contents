      function polarPlace(m, T, first) {
        const A = polarJoint(T, first ? null : m.joint);
        if (!A) { m.out = true; return false; }
        const O = state.pole;
        m.joint = A;
        const psi = Math.atan2(A.y - O.y, A.x - O.x);
        const phi = Math.atan2(T.y - A.y, T.x - A.x);
        m.psi = first ? psi : unwrapTo(m.psi, psi);
        m.phi = first ? phi : unwrapTo(m.phi, phi);
        m.wheel = { x: A.x + WHEEL_S * (T.x - A.x), y: A.y + WHEEL_S * (T.y - A.y) };
        m.TA = T.x * A.y - T.y * A.x;   // T∧A
        m.OA = O.x * A.y - O.y * A.x;   // O∧A: la parte exacta de [A,dA]
        const last = m.trail[m.trail.length - 1];
        if (!last || dist(last, m.wheel) >= 0.8) m.trail.push({ x: m.wheel.x, y: m.wheel.y });
