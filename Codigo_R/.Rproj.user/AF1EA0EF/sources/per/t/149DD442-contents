          }
          text += state.challengeMode
            ? ` · error frente al área real: ${fmtPct(relErr(lr, referenceArea()))}.`
            : (isLinear() ? ': la rueda integra −∮y dx exactamente.' : ': la rueda integra ½∮r² dθ alrededor del polo exactamente.');
          if (state.area < 0) text += ' El signo negativo de ρ solo dice que recorriste en sentido horario; el área se muestra positiva.';
          if (state.crossings > 0) text += ` Tu curva se cruza a sí misma: la lectura es el área algebraica, con cada región contada según su número de vueltas.`;
          setMessage(text + ' Toca la mesa para dibujar otra curva.');
        }
        renderAll();
      }

      // ---------- estado general ----------
      function resetTrace(announce) {
        state.runId += 1;
        state.mode = 'idle';
        state.pointerId = null;
        state.points = [];
        state.cum = [];
        state.closingIndex = -1;
        state.length = 0;
        state.green = 0;
        state.samples = [];
        state.linear = null;
        state.polar = null;
        state.crossings = 0;
        state.crossPts = [];
        state.area = 0;
        state.centroid = null;
        if (announce !== false) setMessage(idleMessage());
      }

      function newTarget() {
        state.target = generateTarget();
        resetTrace(true);
        renderAll();
      }

      function setChallenge(on) {
        state.challengeMode = on;
        if (on) {
          newTarget();
        } else {
          state.target = null;
          resetTrace(true);
          renderAll();
        }
      }

      // ---------- lienzo ----------
      function resizeCanvas() {
        const canvas = els.canvas;
        const rect = canvas.getBoundingClientRect();
        const cssW = rect.width || 720;
        const cssH = cssW * H / W;
        canvas.style.height = cssH + 'px';
        const dpr = window.devicePixelRatio || 1;
        const w = Math.max(1, Math.round(cssW * dpr));
        const h = Math.max(1, Math.round(cssH * dpr));
        if (canvas.width !== w || canvas.height !== h) {
          canvas.width = w;
          canvas.height = h;
        }
        state.scale = w / W;
        scheduleRender();
      }

      function eventToMath(e) {
        const rect = els.canvas.getBoundingClientRect();
        const rw = rect.width || 1;
        const rh = rect.height || (rw * H / W);
        const x = (e.clientX - rect.left) * W / rw;
        const y = (e.clientY - rect.top) * H / rh;
        return { x: clamp(x, 0, W), y: clamp(H - y, 0, H) };
      }

      function sx(x) { return x; }
      function sy(y) { return H - y; }

      function tracePath(ctx, pts) {
        ctx.moveTo(sx(pts[0].x), sy(pts[0].y));
        for (let i = 1; i < pts.length; i += 1) ctx.lineTo(sx(pts[i].x), sy(pts[i].y));
      }
      function strokePath(ctx, pts, color, width, alpha) {
        if (pts.length < 2) return;
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.strokeStyle = color;
        ctx.lineWidth = width;
        ctx.lineJoin = 'round';
        ctx.lineCap = 'round';
        ctx.beginPath();
        tracePath(ctx, pts);
        ctx.stroke();
        ctx.restore();
      }
      function drawDot(ctx, p, r, color) {
        ctx.save();
        ctx.beginPath();
        ctx.arc(sx(p.x), sy(p.y), r, 0, 2 * Math.PI);
        ctx.fillStyle = color;
        ctx.fill();
        ctx.lineWidth = 2;
        ctx.strokeStyle = '#ffffff';
        ctx.stroke();
        ctx.restore();
      }
      function drawSquare(ctx, p, size, color) {
        ctx.save();
        ctx.fillStyle = color;
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.rect(sx(p.x) - size / 2, sy(p.y) - size / 2, size, size);
        ctx.fill();
        ctx.stroke();
        ctx.restore();
      }
      function drawCross(ctx, p, color) {
        ctx.save();
        ctx.strokeStyle = color;
        ctx.lineWidth = 3;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(sx(p.x) - 7, sy(p.y) - 7);
        ctx.lineTo(sx(p.x) + 7, sy(p.y) + 7);
        ctx.moveTo(sx(p.x) - 7, sy(p.y) + 7);
        ctx.lineTo(sx(p.x) + 7, sy(p.y) - 7);
        ctx.stroke();
        ctx.restore();
      }
      function roundRectPath(ctx, x, y, w, h, r) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.lineTo(x + w - r, y);
        ctx.arcTo(x + w, y, x + w, y + r, r);
        ctx.lineTo(x + w, y + h - r);
        ctx.arcTo(x + w, y + h, x + w - r, y + h, r);
        ctx.lineTo(x + r, y + h);
        ctx.arcTo(x, y + h, x, y + h - r, r);
        ctx.lineTo(x, y + r);
        ctx.arcTo(x, y, x + r, y, r);
        ctx.closePath();
      }
      function drawPill(ctx, text, cx, cy, fill, color) {
        ctx.save();
        ctx.font = '700 13px Inter, ui-sans-serif, system-ui, sans-serif';
        const tw = ctx.measureText(text).width;
        const pw = tw + 28;
        const ph = 30;
        roundRectPath(ctx, cx - pw / 2, cy - ph / 2, pw, ph, 15);
        ctx.fillStyle = fill;
        ctx.fill();
        ctx.strokeStyle = 'rgba(15,23,42,0.08)';
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.fillStyle = color;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(text, cx, cy + 1);
        ctx.restore();
      }
      function drawGrid(ctx) {
        ctx.save();
        ctx.strokeStyle = COLORS.grid;
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let x = 0; x <= W; x += UNIT) { ctx.moveTo(x + 0.5, 0); ctx.lineTo(x + 0.5, H); }
        for (let y = 0; y <= H; y += UNIT) { ctx.moveTo(0, y + 0.5); ctx.lineTo(W, y + 0.5); }
        ctx.stroke();
        ctx.restore();
      }
      function drawTarget(ctx, target) {
        ctx.save();
        ctx.beginPath();
        tracePath(ctx, target.points);
        ctx.closePath();
        ctx.fillStyle = COLORS.target;
        ctx.fill();
        ctx.setLineDash([8, 6]);
        ctx.strokeStyle = COLORS.targetStroke;
        ctx.lineWidth = 2;
        ctx.lineJoin = 'round';
        ctx.stroke();
        ctx.restore();
      }
      function drawRailAndBand(ctx) {
        const yTop = RAIL_Y + state.L;
        ctx.save();
        // banda de alcance 0 < y ≤ L sobre la guía
        ctx.fillStyle = COLORS.band;
        ctx.fillRect(0, sy(Math.min(yTop, H)), W, sy(RAIL_Y) - sy(Math.min(yTop, H)));
        ctx.setLineDash([6, 6]);
        ctx.strokeStyle = 'rgba(124,58,237,0.35)';
        ctx.lineWidth = 1.2;
        if (yTop < H) {
          ctx.beginPath();
          ctx.moveTo(0, sy(yTop) + 0.5);
          ctx.lineTo(W, sy(yTop) + 0.5);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = 'rgba(124,58,237,0.7)';
          ctx.font = '700 11px Inter, ui-sans-serif, system-ui, sans-serif';
          ctx.textAlign = 'right';
          ctx.textBaseline = 'bottom';
          ctx.fillText('alcance del brazo: y = L', W - 12, sy(yTop) - 3);
        }
        // guía (riel con rayado)
        ctx.setLineDash([]);
        ctx.strokeStyle = COLORS.rail;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(0, sy(RAIL_Y));
        ctx.lineTo(W, sy(RAIL_Y));
        ctx.stroke();
        ctx.lineWidth = 1;
        ctx.globalAlpha = 0.55;
        ctx.beginPath();
        for (let x = 6; x < W; x += 12) { ctx.moveTo(x, sy(RAIL_Y) + 2); ctx.lineTo(x - 5, sy(RAIL_Y) + 8); }
        ctx.stroke();
        ctx.globalAlpha = 1;
        ctx.fillStyle = COLORS.rail;
        ctx.font = '700 11px Inter, ui-sans-serif, system-ui, sans-serif';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'bottom';
        ctx.fillText('guía del carro', 12, sy(RAIL_Y) - 4);
        ctx.restore();
      }
      function drawStrips(ctx, pts) {
        // franjas verticales entre el trazo y la guía: −∮ y dx por tramos; verde azulado suma (dx < 0), ámbar resta (dx > 0)
        if (pts.length < 2) return;
        const runs = { pos: [], neg: [] };
        let start = 0;
        let sign = 0;
        for (let i = 1; i <= pts.length; i += 1) {
          const sgn = i < pts.length ? Math.sign(pts[i].x - pts[i - 1].x) : 0;
          if (i < pts.length && (sgn === 0 || sgn === sign)) continue;
          if (sign !== 0 && i - 1 > start) (sign < 0 ? runs.pos : runs.neg).push(pts.slice(start, i));
          start = i - 1;
          sign = sgn;
        }
        [['pos', COLORS.stripPos], ['neg', COLORS.stripNeg]].forEach(function (pair) {
          const list = runs[pair[0]];
          if (!list.length) return;
          ctx.save();
          ctx.fillStyle = pair[1];
          ctx.beginPath();
          list.forEach(function (run) {
            ctx.moveTo(sx(run[0].x), sy(RAIL_Y));
            run.forEach(function (p) { ctx.lineTo(sx(p.x), sy(p.y)); });
            ctx.lineTo(sx(run[run.length - 1].x), sy(RAIL_Y));
            ctx.closePath();
          });
          ctx.fill();
          ctx.restore();
        });
      }
      function drawLinearMechanism(ctx, T, m) {
        if (!m || !m.carriage) return;
        const A = m.carriage;
        const Pw = m.wheel;
        const u = unit(T.x - A.x, T.y - A.y);
        const n = { x: -u.y, y: u.x };
        if (m.trail.length > 1) strokePath(ctx, m.trail, COLORS.wheel, 2, 0.8);
        ctx.save();
        // brazo
        ctx.globalAlpha = m.out ? 0.35 : 0.9;
        ctx.strokeStyle = COLORS.ink;
        ctx.lineWidth = 2.4;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(sx(A.x), sy(A.y));
        ctx.lineTo(sx(T.x), sy(T.y));
        ctx.stroke();
        ctx.globalAlpha = 1;
        // carro sobre la guía
        ctx.fillStyle = COLORS.rail;
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.5;
        roundRectPath(ctx, sx(A.x) - 11, sy(A.y) - 7, 22, 14, 4);
        ctx.fill();
        ctx.stroke();
        ctx.restore();
        drawWheelTop(ctx, Pw, n, m.rho / WHEEL_R);
        drawDot(ctx, T, 6.5, COLORS.ink);
      }
      function drawWheelTop(ctx, Pw, n, theta) {
        // rueda vista desde arriba: llanta perpendicular al brazo, eje a lo largo del brazo
        ctx.save();
        ctx.strokeStyle = COLORS.wheelDark;
        ctx.lineWidth = 6;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(sx(Pw.x - WHEEL_R * n.x), sy(Pw.y - WHEEL_R * n.y));
        ctx.lineTo(sx(Pw.x + WHEEL_R * n.x), sy(Pw.y + WHEEL_R * n.y));
        ctx.stroke();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(sx(Pw.x - (WHEEL_R - 2) * n.x), sy(Pw.y - (WHEEL_R - 2) * n.y));
        ctx.lineTo(sx(Pw.x + (WHEEL_R - 2) * n.x), sy(Pw.y + (WHEEL_R - 2) * n.y));
        ctx.stroke();
        // marca en la llanta: desde arriba se ve oscilar a lo largo de la llanta (blanca arriba, oscura cuando toca el papel)
        const mk = { x: Pw.x + WHEEL_R * Math.sin(theta) * n.x, y: Pw.y + WHEEL_R * Math.sin(theta) * n.y };
        ctx.beginPath();
        ctx.arc(sx(mk.x), sy(mk.y), 3.2, 0, 2 * Math.PI);
        if (Math.cos(theta) >= 0) { ctx.fillStyle = '#ffffff'; ctx.fill(); }
        else { ctx.fillStyle = COLORS.wheelDark; ctx.fill(); ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 1; ctx.stroke(); }
        ctx.restore();
      }
      function drawWheelDial(ctx, m) {
        // la rueda de frente: graduación que gira con ρ, índice fijo arriba
        const cx = W - 66;
        const cy = 66;
        const R = 44;
        const theta = m ? m.rho / WHEEL_R : 0;
        ctx.save();
        ctx.translate(cx, cy);
        ctx.beginPath();
        ctx.arc(0, 0, R + 6, 0, 2 * Math.PI);
        ctx.fillStyle = 'rgba(255,255,255,0.94)';
        ctx.fill();
        ctx.strokeStyle = 'rgba(15,23,42,0.12)';
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.save();
        ctx.rotate(-theta);   // ρ > 0 gira en sentido antihorario
        ctx.beginPath();
        ctx.arc(0, 0, R, 0, 2 * Math.PI);
        ctx.strokeStyle = COLORS.wheelDark;
        ctx.lineWidth = 3;
        ctx.stroke();
        ctx.strokeStyle = COLORS.ink;
        ctx.fillStyle = COLORS.ink;
        ctx.font = '700 9px Inter, ui-sans-serif, system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        for (let k = 0; k < 100; k += 1) {
          const ang = -Math.PI / 2 + 2 * Math.PI * k / 100;
          const major = k % 10 === 0;
          const len = major ? 9 : (k % 5 === 0 ? 6 : 3.5);
          ctx.lineWidth = major ? 1.6 : 0.8;
          ctx.beginPath();
          ctx.moveTo((R - 2) * Math.cos(ang), (R - 2) * Math.sin(ang));
          ctx.lineTo((R - 2 - len) * Math.cos(ang), (R - 2 - len) * Math.sin(ang));
          ctx.stroke();
          if (major) ctx.fillText(String(k / 10), (R - 19) * Math.cos(ang), (R - 19) * Math.sin(ang));
        }
        ctx.beginPath();
        ctx.arc(0, 0, 5, 0, 2 * Math.PI);
        ctx.fillStyle = COLORS.wheelDark;
        ctx.fill();
        ctx.restore();
        // índice fijo
        ctx.fillStyle = COLORS.goal;
        ctx.beginPath();
        ctx.moveTo(0, -R + 1);
        ctx.lineTo(-5, -R - 7);
        ctx.lineTo(5, -R - 7);
        ctx.closePath();
        ctx.fill();
        ctx.restore();
        ctx.save();
        ctx.fillStyle = COLORS.wheelDark;
        ctx.font = '800 11px Inter, ui-sans-serif, system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        const turns = m ? wheelTurns(m) : 0;
        ctx.fillText((m && m.out) ? 'fuera de alcance' : ((m ? (m.rho / UNIT).toFixed(2) : '0.00') + ' u · ' + turns.toFixed(2) + ' vueltas'), cx, cy + R + 12);
        ctx.restore();
      }

      function drawPoleAndReach(ctx) {
        const O = state.pole;
        const L = state.L;
        const L1 = poleArm();
        const R0 = zeroCircleRadius();
        ctx.save();
        ctx.beginPath();
        ctx.arc(sx(O.x), sy(O.y), L1 + L, 0, 2 * Math.PI);
        ctx.fillStyle = COLORS.band;
        ctx.fill();
        ctx.setLineDash([6, 6]);
        ctx.strokeStyle = 'rgba(124,58,237,0.35)';
        ctx.lineWidth = 1.2;
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(sx(O.x), sy(O.y), L1, 0, 2 * Math.PI);
        ctx.setLineDash([3, 5]);
        ctx.strokeStyle = 'rgba(71,85,105,0.55)';
        ctx.lineWidth = 1.2;
        ctx.stroke();
        if (Math.abs(R0 - L1) > 0.5) {
          ctx.beginPath();
          ctx.arc(sx(O.x), sy(O.y), R0, 0, 2 * Math.PI);
          ctx.setLineDash([2, 4]);
          ctx.strokeStyle = 'rgba(180,83,9,0.6)';
          ctx.stroke();
        }
        ctx.setLineDash([]);
        ctx.font = '700 11px Inter, ui-sans-serif, system-ui, sans-serif';
        ctx.textBaseline = 'middle';
        ctx.textAlign = 'left';
        ctx.fillStyle = 'rgba(124,58,237,0.75)';
        const rx = O.x + (L1 + L) * 0.72;
        const ry = O.y + (L1 + L) * 0.69;
        if (rx < W - 150 && ry < H - 12) ctx.fillText('alcance del trazador: radio 2L', sx(rx) + 6, sy(ry));
        ctx.fillStyle = 'rgba(71,85,105,0.85)';
        const jx = O.x + L1 * 0.72;
        const jy = O.y + L1 * 0.69;
        if (jy < H - 12 && jx < W - 200) ctx.fillText(Math.abs(R0 - L1) > 0.5 ? 'articulación (radio L)' : 'articulación · círculo cero (radio L)', sx(jx) + 6, sy(jy));
        // polo: pivote fijo
        ctx.beginPath();
        ctx.arc(sx(O.x), sy(O.y), 9, 0, 2 * Math.PI);
        ctx.fillStyle = COLORS.pole;
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(sx(O.x), sy(O.y), 3, 0, 2 * Math.PI);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        ctx.fillStyle = COLORS.pole;
        ctx.textAlign = 'left';
        ctx.textBaseline = 'bottom';
        ctx.fillText('polo', sx(O.x) + 12, sy(O.y) - 6);
        ctx.restore();
      }
      function drawFan(ctx, pts) {
        // sectores desde el polo: ½ r² dθ por tramos; antihorario suma (verde azulado), horario resta (ámbar)
        if (pts.length < 2) return;
        const O = state.pole;
        const runs = { pos: [], neg: [] };
        let start = 0;
        let sign = 0;
        for (let i = 1; i <= pts.length; i += 1) {
          let sgn = 0;
          if (i < pts.length) {
            const a = pts[i - 1];
            const b = pts[i];
            sgn = Math.sign((a.x - O.x) * (b.y - O.y) - (b.x - O.x) * (a.y - O.y));
          }
          if (i < pts.length && (sgn === 0 || sgn === sign)) continue;
          if (sign !== 0 && i - 1 > start) (sign > 0 ? runs.pos : runs.neg).push(pts.slice(start, i));
          start = i - 1;
          sign = sgn;
        }
        [['pos', COLORS.stripPos], ['neg', COLORS.stripNeg]].forEach(function (pair) {
          const list = runs[pair[0]];
          if (!list.length) return;
          ctx.save();
          ctx.fillStyle = pair[1];
          ctx.beginPath();
          list.forEach(function (run) {
            ctx.moveTo(sx(O.x), sy(O.y));
            run.forEach(function (p) { ctx.lineTo(sx(p.x), sy(p.y)); });
            ctx.closePath();
          });
          ctx.fill();
          ctx.restore();
        });
      }
      function drawPolarMechanism(ctx, T, m) {
        if (!m || !m.joint) return;
        const O = state.pole;
        const A = m.joint;
        const u = unit(T.x - A.x, T.y - A.y);
        const n = { x: -u.y, y: u.x };
        if (m.trail.length > 1) strokePath(ctx, m.trail, COLORS.wheel, 2, 0.8);
        ctx.save();
        ctx.globalAlpha = m.out ? 0.35 : 0.9;
        ctx.lineCap = 'round';
        // brazo polar
        ctx.strokeStyle = COLORS.rail;
        ctx.lineWidth = 2.4;
        ctx.beginPath();
        ctx.moveTo(sx(O.x), sy(O.y));
        ctx.lineTo(sx(A.x), sy(A.y));
        ctx.stroke();
        // brazo trazador
        ctx.strokeStyle = COLORS.ink;
        ctx.beginPath();
        ctx.moveTo(sx(A.x), sy(A.y));
        ctx.lineTo(sx(T.x), sy(T.y));
        ctx.stroke();
        ctx.globalAlpha = 1;
        // articulación
        ctx.beginPath();
        ctx.arc(sx(A.x), sy(A.y), 5.5, 0, 2 * Math.PI);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        ctx.strokeStyle = COLORS.rail;
        ctx.lineWidth = 2.2;
        ctx.stroke();
        ctx.restore();
        drawWheelTop(ctx, m.wheel, n, m.rho / WHEEL_R);
        drawDot(ctx, T, 6.5, COLORS.ink);
      }
      function drawPRMap(ctx) {
        drawTarget(ctx, state.target);
