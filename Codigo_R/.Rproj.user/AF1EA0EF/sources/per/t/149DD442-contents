        statReachSub: document.getElementById('stat-reach-sub'),
        success: document.getElementById('success-card'),
        successTitle: document.getElementById('success-title'),
        successText: document.getElementById('success-text')
      };

      // ---------- constantes de la mesa (coordenadas lógicas, eje y hacia arriba) ----------
      const W = 720;
      const H = 480;
      const UNIT = 40;          // 1 u = 40 px lógicos (la cuadrícula)
      const MIN_SEG = 1.2;      // distancia mínima entre puntos registrados del trazo
      const CLOSE_WINDOW = 60;  // cruzar los primeros 60 px del trazo cierra la curva
      const LOOP_MIN_AREA = 0.3 * UNIT * UNIT; // lazos más pequeños se consideran temblor de la mano
      const LOOP_MIN_LEN = 90;
      const SNAP_RADIUS = 7;    // volver a menos de 7 px del inicio cierra la curva
      const RAIL_Y = 0.5 * UNIT;   // altura de la guía del planímetro lineal sobre el borde inferior
      const WHEEL_R = 0.3 * UNIT;  // radio de la rueda integradora
      const WHEEL_S = 0.5;         // posición de la rueda: fracción del brazo trazador medida desde el carro / la articulación
      const POLES = {
        esquina: { x: 1.5 * UNIT, y: 1.5 * UNIT, label: 'esquina inferior izquierda' },
        abajo: { x: 9 * UNIT, y: 0.9 * UNIT, label: 'borde inferior, al centro' },
        centro: { x: 9 * UNIT, y: 6 * UNIT, label: 'centro de la mesa' }
      };
      const COLORS = {
        curve: '#7c3aed',
        fan: 'rgba(124,58,237,0.10)',
        wheel: '#0d9488',
        wheelDark: '#0f766e',
        start: '#16a34a',
        goal: '#ef4444',
        ink: '#0f172a',
        grid: 'rgba(15,23,42,0.07)',
        target: 'rgba(239,68,68,0.09)',
        targetStroke: '#f87171',
        muted: '#64748b',
        rail: '#475569',
        pole: '#b45309',
        band: 'rgba(124,58,237,0.045)',
        stripPos: 'rgba(13,148,136,0.16)',
        stripNeg: 'rgba(245,158,11,0.18)'
      };

      const state = {
        L: 7 * UNIT,
        instrument: 'polar',     // polar (Amsler) | linear (carro en guía recta)
        poleKey: 'esquina',
        pole: { x: POLES.esquina.x, y: POLES.esquina.y },
        mode: 'idle',            // idle | drawing | closing | closed
        challengeMode: false,
        target: null,
        pointerId: null,
        runId: 0,
        scale: 1,
        points: [],
        cum: [],
        closingIndex: -1,
        length: 0,
        green: 0,
        samples: [],
        linear: null,
        polar: null,
        crossings: 0,
        crossPts: [],
        area: 0,
        centroid: null
      };

      // ---------- utilidades geométricas ----------
      function dist(a, b) { return Math.hypot(a.x - b.x, a.y - b.y); }
      function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
      function unit(x, y) { const n = Math.hypot(x, y) || 1; return { x: x / n, y: y / n }; }
      function orient(a, b, c) { return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x); }
      function segmentIntersection(p1, p2, p3, p4) {
        const d1 = orient(p3, p4, p1);
        const d2 = orient(p3, p4, p2);
        const d3 = orient(p1, p2, p3);
        const d4 = orient(p1, p2, p4);
        const cross1 = (d1 > 0 && d2 < 0) || (d1 < 0 && d2 > 0);
        const cross2 = (d3 > 0 && d4 < 0) || (d3 < 0 && d4 > 0);
        if (!cross1 || !cross2) return null;
        const t = d1 / (d1 - d2);
        return { x: p1.x + t * (p2.x - p1.x), y: p1.y + t * (p2.y - p1.y) };
      }
      function shoelace(poly) {
        let s = 0;
        for (let i = 0; i < poly.length; i += 1) {
          const a = poly[i];
          const b = poly[(i + 1) % poly.length];
          s += a.x * b.y - b.x * a.y;
        }
        return s / 2;
      }
      function polygonCentroid(poly) {
        let a = 0;
        let cx = 0;
        let cy = 0;
        for (let i = 0; i < poly.length; i += 1) {
          const p = poly[i];
          const q = poly[(i + 1) % poly.length];
          const c = p.x * q.y - q.x * p.y;
          a += c;
          cx += (p.x + q.x) * c;
          cy += (p.y + q.y) * c;
        }
        a /= 2;
        if (Math.abs(a) < 1e-9) {
          let sx = 0;
          let sy = 0;
          poly.forEach(function (p) { sx += p.x; sy += p.y; });
          return { x: sx / poly.length, y: sy / poly.length };
        }
        return { x: cx / (6 * a), y: cy / (6 * a) };
      }
      function insidePolygon(poly, P) {
        let inside = false;
        for (let i = 0, j = poly.length - 1; i < poly.length; j = i, i += 1) {
          const a = poly[i];
          const b = poly[j];
          const crosses = (a.y > P.y) !== (b.y > P.y);
          if (crosses && P.x < (b.x - a.x) * (P.y - a.y) / (b.y - a.y) + a.x) inside = !inside;
        }
        return inside;
      }
      function polygonPoints() {
        const pts = state.points;
        if (pts.length > 2 && dist(pts[0], pts[pts.length - 1]) < 1e-9) return pts.slice(0, -1);
        return pts.slice();
