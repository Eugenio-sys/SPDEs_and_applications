      }
      function outZoneMessage() {
        return isLinear()
          ? 'Te saliste de la zona de dibujo del planímetro lineal: el carro solo alcanza la banda 0 < y ≤ L sobre la guía. El trazo se borró: dibuja dentro de la banda sombreada (o elige un brazo más largo).'
          : 'Te saliste de la zona de dibujo del planímetro polar: el brazo llega hasta 2L del polo. El trazo se borró: dibuja dentro del disco sombreado (o acerca el polo, o alarga el brazo).';
      }
      function instrumentMove(Q, P) {
        if (isLinear()) {
          if (!state.linear) state.linear = makeLinear(Q);
          linearMove(state.linear, Q, P);
        } else {
          if (!state.polar) state.polar = makePolar(Q);
          polarMove(state.polar, Q, P);
        }
      }

      // ---------- planímetro lineal: carro en una guía recta, rueda a mitad del brazo ----------
      // Con A = (a, 0) en la guía, T = A + L u y la rueda en P = A + s u (eje paralelo al brazo):
      //   dρ = dP·n = dA·n + s dφ = −(y/L) dx + σ y² dy / (L √(L²−y²)) + s dφ,
      // donde y es la altura del trazador sobre la guía y σ = ±1 según el lado del carro.
      // Los dos últimos términos son diferenciales exactas, así que al cerrar la curva L·ρ = −∮ y dx = A (Green).
      function linearF(h) {
        const L = state.L;
        const hh = clamp(h, -L, L);
        return (L * L / 2) * Math.asin(hh / L) - (hh / 2) * Math.sqrt(Math.max(0, L * L - hh * hh));
      }
      function linearPlace(m, T) {
        const h = T.y - RAIL_Y;
        const L = state.L;
        const root = Math.sqrt(Math.max(0, L * L - h * h));
        const a = T.x + m.sigma * root;
        m.carriage = { x: a, y: RAIL_Y };
        m.phi = Math.atan2(h, T.x - a);
        m.wheel = { x: a + WHEEL_S * (T.x - a), y: RAIL_Y + WHEEL_S * h };
        m.aMin = Math.min(m.aMin, a);
        m.aMax = Math.max(m.aMax, a);
        const last = m.trail[m.trail.length - 1];
        if (!last || dist(last, m.wheel) >= 0.8) m.trail.push({ x: m.wheel.x, y: m.wheel.y });
      }
      function makeLinear(T0) {
        const h0 = T0.y - RAIL_Y;
        const reach = h0 > 0 && h0 <= state.L;
        const m = {
          sigma: (T0.x >= W / 2) ? -1 : 1,   // carro a la izquierda del trazador (σ = −1) o a la derecha (σ = +1)
          ydx: 0,
          rho: 0,
          phi: 0,
          phi0: 0,
          F0: 0,
          out: !reach,
          carriage: null,
          wheel: null,
          trail: [],
          aMin: Infinity,
          aMax: -Infinity,
          hMax: h0
        };
        if (reach) {
          linearPlace(m, T0);
          m.phi0 = m.phi;
          m.F0 = linearF(h0);
        }
        return m;
      }
      function linearMove(m, Q, P) {
        if (m.out) return;
        const hQ = Q.y - RAIL_Y;
        const hP = P.y - RAIL_Y;
        m.hMax = Math.max(m.hMax, hP);
        if (hP <= 0 || hP > state.L) { m.out = true; return; }
        m.ydx += 0.5 * (hQ + hP) * (P.x - Q.x);   // ∫ y dx exacto sobre el segmento recto
        linearPlace(m, P);
        const L = state.L;
        m.rho = -m.ydx / L + m.sigma * (linearF(hP) - m.F0) / L + WHEEL_S * L * (m.phi - m.phi0);
      }
      function linearReading(m) { return (m && !m.out) ? state.L * m.rho : null; }
