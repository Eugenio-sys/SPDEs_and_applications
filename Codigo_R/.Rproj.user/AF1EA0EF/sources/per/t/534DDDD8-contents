    function maybeSolved(){if(!solved())return;setStatus('Las seis caras vuelven a ser uniformes. Cubo resuelto.','✓ Resuelto');if(challenge)showSuccess()}
    function resetSolved(){stopTimer();build();history=[];scrambleBase=0;currentScramble=[];playerMoves=0;hintCount=0;challenge=false;elapsed=0;success.className='success-card';setStatus('Cubo resuelto. Arrastra un sticker para girar una capa, o el fondo para mover la cámara.','Listo');renderAll()}
    function scramble(asChallenge){if(busy)return;stopTimer();build();history=[];playerMoves=0;hintCount=0;elapsed=0;challenge=!!asChallenge;success.className='success-card';currentScramble=generateScramble(parseInt(scrambleLen.value,10)||20);setStatus(asChallenge?'Preparando el reto…':'Mezclando el cubo…','Scramble');runSequence(currentScramble,{purpose:'scramble',record:true,count:false},()=>{scrambleBase=history.length;playerMoves=0;elapsed=0;resetTimer();setStatus(asChallenge?'Reto listo. El cronómetro comienza con tu primer giro.':'Cubo mezclado. Intenta resolverlo.','Mezclado');hintText.textContent=asChallenge?'Resuélvelo sin pistas para aspirar a oro o plata.':'Activa el reto para registrar puntuación.';renderAll()})}
    let pendingMoves=[];
    function pumpPending(){if(busy||!pendingMoves.length)return;const t=pendingMoves.shift();runSequence([t],{purpose:'user',record:true,count:true,quiet:true},()=>{maybeSolved();pumpPending()})}
    function userMove(t){if(pendingMoves.length>32)return;pendingMoves.push(t);pumpPending()}
    function undo(){if(busy)return;if(history.length<=scrambleBase){setStatus('No hay movimientos tuyos para deshacer.','Sin deshacer');return}const last=history[history.length-1];runSequence([inverseToken(last)],{purpose:'solve',record:false,count:false,quiet:true},()=>{history.pop();playerMoves=Math.max(0,playerMoves-1);setStatus(`Se deshizo ${last}.`,'Deshacer');renderAll()})}
    function solveHistory(){if(busy)return;if(!history.length){setStatus('El cubo ya está resuelto.','✓ Resuelto');return}challenge=false;stopTimer();success.className='success-card';const seq=inverseSeq(history);setStatus(`Ejecutando ${seq.length} movimientos inversos al historial. No se afirma que sea la solución mínima.`,'Resolviendo');runSequence(seq,{purpose:'solve',record:false,count:false},()=>{history=[];scrambleBase=0;currentScramble=[];playerMoves=0;setStatus('Cubo resuelto mediante la inversa del historial.','✓ Resuelto');renderAll()})}
    function hint(){if(!history.length){hintText.textContent='El cubo ya está resuelto.';return}hintCount++;const t=inverseToken(history[history.length-1]);hintText.innerHTML=`Movimiento garantizado para regresar por el historial: <strong>${t}</strong>. No necesariamente es óptimo.`}
    function updateAlg(){const a=algorithms[algorithmSelect.value];algorithmSeq.textContent=a.seq.join(' ');algorithmDesc.textContent=a.desc}
    function runAlg(inv){if(busy)return;const a=algorithms[algorithmSelect.value],seq=inv?inverseSeq(a.seq):a.seq;runSequence(seq,{purpose:'user',record:true,count:true},()=>{setStatus(`${inv?'Inversa de ':''}${a.name} ejecutada.`,'Algoritmo');maybeSolved()})}

    ['U','D','L','R','F','B',"U'","D'","L'","R'","F'","B'",'U2','D2','L2','R2','F2','B2'].forEach(t=>{const b=document.createElement('button');b.type='button';b.className='move-btn'+(t.endsWith("'")?' prime':t.endsWith('2')?' double':'');b.textContent=t;b.dataset.move=t;b.addEventListener('click',()=>userMove(t));movesGrid.appendChild(b)});
    root.querySelector('#front-view-btn').addEventListener('click',()=>{
      animateViewTo(-11,16,1.03);
      setStatus('Vista casi frontal: se conserva un poco de cara superior y lateral para mantener la profundidad.','Vista frontal');
    });
    root.querySelector('#scramble-btn').addEventListener('click',()=>scramble(false));root.querySelector('#challenge-btn').addEventListener('click',()=>scramble(true));root.querySelector('#reset-btn').addEventListener('click',resetSolved);root.querySelector('#undo-btn').addEventListener('click',undo);root.querySelector('#solve-btn').addEventListener('click',solveHistory);root.querySelector('#hint-btn').addEventListener('click',hint);root.querySelector('#run-algorithm').addEventListener('click',()=>runAlg(false));root.querySelector('#invert-algorithm').addEventListener('click',()=>runAlg(true));algorithmSelect.addEventListener('change',updateAlg);
    root.querySelectorAll('.tab-btn').forEach(b=>b.addEventListener('click',()=>{root.querySelectorAll('.tab-btn').forEach(x=>x.classList.toggle('active',x===b));root.querySelectorAll('.tab-panel').forEach(p=>p.classList.toggle('active',p.dataset.panel===b.dataset.tab))}));
    stage.addEventListener('pointerdown',e=>{
      cancelInertia();
      if(busy)return;
      const sticker=e.target.closest&&e.target.closest('.cubie-face.sticker');
      gesture={mode:sticker?'slice':'camera',id:e.pointerId,startX:e.clientX,startY:e.clientY,lastX:e.clientX,lastY:e.clientY,source:sticker||null,cubie:sticker?sticker._rubikCubie:null,localNormal:sticker?sticker._rubikLocalNormal:null,choice:null,preview:null,targetFrac:0,samples:[{t:performance.now(),x:e.clientX,y:e.clientY}]};
      if(sticker){
        sticker.classList.add('drag-source');
        setStatus('Mantén presionado y arrastra arriba, abajo, izquierda o derecha: moverás la fila o columna que atraviesa este sticker.','Giro directo');
        e.preventDefault();
      }
      try{stage.setPointerCapture&&stage.setPointerCapture(e.pointerId)}catch(err){}
    });
    stage.addEventListener('pointermove',e=>{
      if(!gesture.mode||e.pointerId!==gesture.id)return;
      if(gesture.mode==='camera'){
        const dx=e.clientX-gesture.lastX,dy=e.clientY-gesture.lastY;
        gesture.lastX=e.clientX;gesture.lastY=e.clientY;
        // Bola de arrastre: cada tramo gira en ejes de pantalla; se puede tumbar el cubo sin limite
        // y el control nunca se invierte (arrastrar arriba sigue levantando el cubo, como antes).
        spinView(dx*.45,-dy*.45);applyView();
        const now=performance.now();
        gesture.samples.push({t:now,x:e.clientX,y:e.clientY});
        while(gesture.samples.length>2&&now-gesture.samples[0].t>110)gesture.samples.shift();
        return;
      }
      const dx=e.clientX-gesture.startX,dy=e.clientY-gesture.startY;
      if(!gesture.choice){
        gesture.choice=inferStickerDrag(gesture.cubie,gesture.localNormal,dx,dy);
        if(gesture.choice){
          gesture.preview=makePreview(gesture.choice);
          setStatus(`Gesto reconocido: ${gesture.choice.token}. La capa sigue tu mano en los dos sentidos; suelta para completar el giro (o su inverso).`,'Giro directo');
        }
      }
      if(gesture.choice&&gesture.preview){
        const projection=dx*gesture.choice.dir[0]+dy*gesture.choice.dir[1];
        gesture.targetFrac=projection/72;
        ensureFollow();
      }
    });
    function endGesture(e,cancelled){
      if(!gesture.mode)return;
      if(gesture.source)gesture.source.classList.remove('drag-source');
      const mode=gesture.mode,preview=gesture.preview,samples=gesture.samples||[],targetF=gesture.targetFrac;
      cancelFollow();
      gesture={mode:null,id:null,startX:0,startY:0,lastX:0,lastY:0,source:null,cubie:null,localNormal:null,choice:null,preview:null,targetFrac:0};
      if(mode==='camera'&&!cancelled&&samples.length>=2){
        const now=performance.now(),last=samples[samples.length-1];
        if(now-last.t<=80){
          let first=samples[0];
          for(let i=samples.length-1;i>=0;i--){if(last.t-samples[i].t>=30){first=samples[i];break}}
          const dt=Math.max(8,last.t-first.t);
          let path=0;
          for(let i=1;i<samples.length;i++){
            if(last.t-samples[i-1].t<=100)path+=Math.hypot(samples[i].x-samples[i-1].x,samples[i].y-samples[i-1].y);
          }
          const vx=.45*(last.x-first.x)/dt,vy=-.45*(last.y-first.y)/dt;
          // La inercia solo se enciende con un lanzamiento deliberado: velocidad sostenida Y recorrido real.
          // El micro-arrastre de levantar el dedo (roll-off) no pasa los filtros: el cubo queda donde lo soltaste.
          if(path>=16&&Math.hypot(vx,vy)>=.12)startInertia(vx,vy);
        }
      }
      if(mode==='slice'&&preview){
        const target=(!cancelled&&targetF>=.27)?1:((!cancelled&&targetF<=-.27)?-1:0);
        settlePreview(preview,target);
      }
    }
    stage.addEventListener('pointerup',e=>endGesture(e,false));
    stage.addEventListener('pointercancel',e=>endGesture(e,true));
    
    root.addEventListener('keydown',e=>{const tag=(e.target&&e.target.tagName||'').toLowerCase();if(['input','select','button'].includes(tag))return;const k=e.key.toUpperCase();if(!faceInfo[k])return;e.preventDefault();userMove(e.shiftKey?k+"'":k)});
    root._rubikTest={
      getView:()=>({m:view.m.map(r=>r.slice()),scale:view.scale}),
      inertiaOn:()=>inertiaId!==null,
      screenVec:(v)=>screenVec(v),
      inverseToken:(t)=>inverseToken(t),
      getState:()=>({moves:playerMoves,solved:solved(),history:history.slice()}),
      inferByHome:(home,code,dx,dy)=>{
        const el=root.querySelector(`.sticker[data-home-pos="${home}"][data-sticker-code="${code}"]`);
        return el?inferStickerDrag(el._rubikCubie,el._rubikLocalNormal,dx,dy):null;
      }
    };
    updateAlg();viewInit();applyView();resetSolved();
  })();
  )---"

